  <folder name="Application" id="id-68342c902575472cb33f2666fb02fb56" type="application">
    <folder name="SDH" id="id-fb238dc01501487cab1e5ebcac705bf9">
      <element xsi:type="archimate:ApplicationComponent" name="Plataforma SDH" id="id-4412020d1a3746d08b608a384c9187fb">
        <documentation>Componente raíz de la solución. Agrupa SDH.Domain, SDH.Application, SDH.Infrastructure y la capa de presentación MVC en una arquitectura hexagonal (Ports and Adapters).</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="SDH.Domain" id="id-app-cmp-001">
        <documentation>Entidades de negocio con factory methods (Crear), enums de catálogo con atributo MappedCatalog, puertos de dominio (IPasswordHasher). Sin dependencias externas.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="SDH.Application" id="id-app-cmp-002">
        <documentation>Servicios de aplicación (CQRS: AutenticacionService, CustomerCommandService, UserCommandService, CatalogoService, FileExtractionService), DTOs, puertos (interfaces) e inyección de dependencias.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="SDH.Infrastructure" id="id-app-cmp-003">
        <documentation>Adaptadores: EF Core 10 (ApplicationDbContext), repositorios, UnitOfWork, LdapAuthenticationService, CatalogQueryService, ClienteQueryService, ConfigDecryptionService, seeders y CatalogosCacheInitializer.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="SDH.Presentation" id="id-app-cmp-004">
        <documentation>ASP.NET Core 10 Razor Pages con Tailwind CSS y Blazorise. Expone páginas web (Login, Dashboard, Clientes, Users, BulkUpload) y endpoints API REST documentados con Swagger.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="SDH.SecretTool (CLI)" id="id-app-cmp-005">
        <documentation>Herramienta de consola para cifrar y descifrar valores de configuración usando AES-256-CBC con la clave CONFIG_MASTER_KEY.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Servicio de Validación de Contactabilidad" id="id-58f7c13d243f40d6b95208fc27152e19">
        <documentation>Valida teléfonos (formato, dígitos, duplicados), correos (formato, dominio, bounce), direcciones (longitud, completitud) y gestiona estado LOPDP de los contactos del cliente.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Servicio de Autenticación" id="id-app-svc-001">
        <documentation>AutenticacionService: valida credenciales contra LDAP/AD o BD local (BCrypt). Genera JWT (60 min) y cookie de sesión HttpOnly (8h sliding). Soporta fallback entre proveedores.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Servicio de Gestión de Clientes" id="id-app-svc-002">
        <documentation>CustomerCommandService: crea y actualiza clientes (aggregate root) con sus contactos, direcciones y datos financieros. Aplica Result Pattern para errores de negocio.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Servicio de Gestión de Usuarios" id="id-app-svc-003">
        <documentation>UserCommandService: crea y actualiza cuentas de usuario validando roles contra el catálogo. Aplica hash BCrypt a contraseñas vía IPasswordHasher.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Servicio de Catálogos (con Caché)" id="id-app-svc-004">
        <documentation>CatalogoService: lee catálogos desde IMemoryCache (TTL 1h, tamaño máx 2000 items). Invalida y recarga al modificar. CatalogosCacheInitializer los precarga al inicio.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Servicio de Carga de Archivos" id="id-app-svc-005">
        <documentation>FileExtractionService extrae identificaciones desde .xlsx, .xls, .csv (máx 10 MB). FileValidationService valida formato y cabeceras antes del procesamiento.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Adaptador LDAP / Active Directory" id="id-app-svc-006">
        <documentation>LdapAuthenticationService (Novell.Directory.Ldap 4.0.0): conecta a AD en 10.107.41.155:389, valida usuario contra bancomachala.des y mapea grupos (G_DSH_SUPAD, G_DSH_AUDIT, G_DSH_USER) a roles del sistema.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Servicio de Descifrado de Configuración" id="id-app-svc-007">
        <documentation>ConfigDecryptionService: descifra valores prefijados con ENC: en appsettings.json usando AES-256-CBC con la clave de entorno CONFIG_MASTER_KEY. Protege strings de conexión y contraseña LDAP.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Integración Equifax (Staging)" id="id-1ce998409d5245faba20c071d7f3877d">
        <documentation>Carga de datos externos Equifax al esquema 'carga' para enriquecimiento de información de clientes. Proceso batch externo que alimenta las tablas de staging.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="ITokenGenerator" id="id-app-ifc-001">
        <documentation>Puerto para generación de JWT y ClaimsPrincipal. Implementado por TokenGenerator en SDH.Infrastructure.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="ILdapAuthenticationService" id="id-app-ifc-002">
        <documentation>Puerto de autenticación LDAP. Implementado por LdapAuthenticationService en SDH.Infrastructure.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="IUnitOfWork" id="id-app-ifc-003">
        <documentation>Puerto de gestión de transacciones: SaveChangesAsync, BeginTransactionAsync, CommitTransactionAsync, RollbackTransactionAsync.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="ICatalogQueryService" id="id-app-ifc-004">
        <documentation>Puerto de consulta de catálogos (CQRS Read Side): GetAllAsync, GetActiveAsync, GetByGroupNameAsync, GetItemByCodeAsync, CheckIntegrityAsync.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="IClienteQueryService" id="id-app-ifc-005">
        <documentation>Puerto de consulta de clientes (CQRS Read Side): búsqueda fuzzy para dropdowns, lookups por identificación.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="IFileExtractionService" id="id-app-ifc-006">
        <documentation>Puerto de extracción de datos desde archivos: soporta .xlsx, .xls, .csv. Valida cabeceras y tamaño (máx 10 MB).</documentation>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="IPasswordHasher" id="id-app-ifc-007">
        <documentation>Puerto de hashing de contraseñas. Implementado con BCrypt.Net-Next 4.1.0.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="IConfigDecryptionService" id="id-app-ifc-008">
        <documentation>Puerto de descifrado de configuración AES-256-CBC. Lee CONFIG_MASTER_KEY desde variables de entorno.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="ICurrentUserService" id="id-app-ifc-009">
        <documentation>Puerto para obtener el usuario autenticado actual desde HttpContext.User claims.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Cliente (Aggregate Root)" id="id-do-001">
        <documentation>operativo.Tbl_Maest_Cliente. Contiene identificación, nombre, tipo de identificación, flags de verificación/aprobación/anonimización, fecha de expiración legal y colecciones: Contactos, Direcciones, Financieros, Oficializaciones.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Contacto del Cliente" id="id-do-002">
        <documentation>operativo.Tbl_Contacto_Cliente. Teléfonos, correos, WhatsApp, direcciones, referencias personales/comerciales, links. Incluye estado de verificación (ESTADO_CONTACTABILIDAD) y estado LOPDP.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Dirección del Cliente" id="id-do-003">
        <documentation>operativo.Tbl_Direccion_Cliente. Direcciones domiciliarias y de trabajo del cliente.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Datos Financieros del Cliente" id="id-do-004">
        <documentation>operativo.Tbl_Financiero_cliente. Tipo de contabilidad (TIPO_CONTABILIDAD) y monto contable.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Oficialización Core" id="id-do-005">
        <documentation>operativo.Tbl_Oficializacion_Core. Registros de oficialización formal de datos del cliente hacia sistemas core bancarios.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Usuario del Sistema" id="id-do-006">
        <documentation>seguridad.Tbl_Maest_Usuario. Credenciales (hash BCrypt), rol del sistema (ROL_SISTEMA), estado (ESTADO_USUARIO), flags de bloqueo/eliminación y fecha de último acceso.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Catálogo (Grupo + Items)" id="id-do-007">
        <documentation>parametro.Tbl_Cat_Grupo + parametro.Tbl_Cat_Item. Enumeraciones configurables: TIPO_CONTACTO, ESTADO_CONTACTABILIDAD, ESTADO_CLIENTE, ROL_SISTEMA, ESTADO_USUARIO, TIPO_IDENTIFICACION, ESTADO_ARCHIVO, TIPO_CONTABILIDAD. Vista: Vw_Cat_Detalle_General.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Archivo de Carga (.xlsx / .csv)" id="id-do-008">
        <documentation>Archivo subido por el usuario para carga masiva de identificaciones. Formatos soportados: .xlsx, .xls, .csv. Máximo 10 MB.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Token JWT + Cookie de Sesión" id="id-do-009">
        <documentation>JWT firmado (issuer: SmartHubAPI, audience: SmartHubUsers, expiry: 60 min) para acceso API + Cookie HttpOnly SameSite:Strict (8h sliding) para sesión web.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="AuthController" id="id-51004367c62b4612b873b67c8416135a">
        <documentation>Login del usuario</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="CatalogosController" id="id-f0c8b74dc93441589840424c751f4de5"/>
      <element xsi:type="archimate:DataObject" name="ClientController" id="id-b563c1217f8e40f888b666426c47a245"/>
      <element xsi:type="archimate:DataObject" name="UsersController" id="id-a60001572c9b489ba18a8bd8afd9e9a2"/>
      <element xsi:type="archimate:ApplicationService" name="Application Db Context" id="id-bbbd4f53067d4af4951128e67e7baa08"/>
      <element xsi:type="archimate:DataObject" name="CatalogosCacheInitializer" id="id-828eee48d23f4ba3a6bf187d39d5f252">
        <documentation>Catalogos necesario</documentation>
      </element>
