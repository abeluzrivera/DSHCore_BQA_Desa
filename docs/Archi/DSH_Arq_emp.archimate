  <folder name="Motivation" id="id-2cafcb3a8dee42c088d744e369c55021" type="motivation">
    <element xsi:type="archimate:Driver" name="Clientes inalcanzables por canales convencionales" id="id-mot-drv-001"/>
    <element xsi:type="archimate:Driver" name="Cumplimiento LOPDP (Protección de Datos Personales)" id="id-mot-drv-002"/>
    <element xsi:type="archimate:Driver" name="Baja calidad e inconsistencia de datos maestros" id="id-mot-drv-003"/>
    <element xsi:type="archimate:Goal" name="Maximizar la contactabilidad efectiva de clientes" id="id-mot-gol-001"/>
    <element xsi:type="archimate:Goal" name="Mantener fuente única de verdad de datos de clientes" id="id-mot-gol-002"/>
    <element xsi:type="archimate:Goal" name="Garantizar cumplimiento normativo de datos personales" id="id-mot-gol-003"/>
    <element xsi:type="archimate:Requirement" name="Autenticación dual: LDAP/AD + BD local (fallback)" id="id-mot-req-001"/>
    <element xsi:type="archimate:Requirement" name="Secretos de configuración cifrados (AES-256-CBC)" id="id-mot-req-002"/>
    <element xsi:type="archimate:Requirement" name="Auditoría completa (CreatedBy, ModifiedBy, timestamps)" id="id-mot-req-003"/>
    <element xsi:type="archimate:Requirement" name="Carga masiva de identificaciones (.xlsx, .xls, .csv)" id="id-mot-req-004"/>
    <element xsi:type="archimate:Constraint" name="Máximo 10 MB por archivo de carga" id="id-mot-cst-001"/>
    <element xsi:type="archimate:Constraint" name="Cookie de sesión máximo 8 horas (sliding expiration)" id="id-mot-cst-002"/>
    <element xsi:type="archimate:Constraint" name="Entorno: Development / Staging / Production" id="id-mot-cst-003"/>
    <element xsi:type="archimate:Principle" name="Arquitectura Hexagonal (Ports &amp; Adapters)" id="id-mot-prn-001"/>
    <element xsi:type="archimate:Principle" name="CQRS: Separación de lecturas y escrituras" id="id-mot-prn-002"/>
    <element xsi:type="archimate:Principle" name="Domain-Driven Design (DDD)" id="id-mot-prn-003"/>
    <element xsi:type="archimate:Principle" name="Result Pattern (sin excepciones de negocio)" id="id-mot-prn-004"/>
    <element xsi:type="archimate:Principle" name="Nombres de dominio en español (ubiquitous language)" id="id-mot-prn-005"/>
  </folder>
