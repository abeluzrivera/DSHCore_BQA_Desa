  <folder name="Business" id="id-cd00836438154ce3bd4513924bd0f246" type="business">
    <element xsi:type="archimate:BusinessActor" name="Agente de Contacto" id="id-biz-act-001"/>
    <element xsi:type="archimate:BusinessActor" name="Supervisor" id="id-biz-act-002"/>
    <element xsi:type="archimate:BusinessActor" name="Administrador del Sistema" id="id-biz-act-003"/>
    <element xsi:type="archimate:BusinessActor" name="Usuario de Consulta" id="id-biz-act-004"/>
    <element xsi:type="archimate:BusinessActor" name="Equifax (Sistema Externo)" id="id-biz-act-005"/>
    <element xsi:type="archimate:BusinessActor" name="Active Directory (Banco Machala)" id="id-biz-act-006"/>
    <element xsi:type="archimate:BusinessRole" name="Rol: AGENTE" id="id-biz-rol-001"/>
    <element xsi:type="archimate:BusinessRole" name="Rol: SUPERVISOR" id="id-biz-rol-002"/>
    <element xsi:type="archimate:BusinessRole" name="Rol: ADMIN" id="id-biz-rol-003"/>
    <element xsi:type="archimate:BusinessRole" name="Rol: CONSULTA" id="id-biz-rol-004"/>
    <element xsi:type="archimate:BusinessProcess" name="Gestión y Verificación de Clientes" id="id-biz-prc-001">
      <documentation>Registrar, actualizar y verificar la información de contacto de los clientes: teléfonos, correos electrónicos y direcciones.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Carga Masiva de Identificaciones" id="id-biz-prc-002">
      <documentation>Importación de listas de RUC, DNI o PAS desde archivos .xlsx, .xls o .csv para procesamiento en lote (máximo 10 MB).</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Gestión de Usuarios del Sistema" id="id-biz-prc-003">
      <documentation>Creación, modificación y desactivación de cuentas de usuario con roles asignados vía catálogo.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Configuración de Catálogos" id="id-biz-prc-004">
      <documentation>Administración de las listas de valores del sistema: tipos de contacto, estados, roles, tipos de identificación, etc.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Autenticación y Control de Acceso" id="id-biz-prc-005">
      <documentation>Validación de identidad del usuario via LDAP/AD o base de datos local y emisión de token de sesión JWT + cookie (8h).</documentation>
    </element>
