<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="DSH" id="id-926a377cb8a24b179eed0c2f6927d37d" version="5.0.0">
  <folder name="Strategy" id="id-5aa42b5c50e247bebaabb62aebfb299c" type="strategy">
    <element xsi:type="archimate:Capability" name="Gestión de Datos Maestros de Clientes (MDM)" id="id-ad39e76afcba4052a276b5483f0b2bb4">
      <documentation>Capacidad de gobernar, estructurar y mantener una &quot;fuente única de la verdad&quot; de los datos demográficos, transaccionales y de perfil de los clientes a lo largo de todos los sistemas del negocio.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Gestión de Contactabilidad" id="id-a0c96e1849b645b5827c4e704ab775b4">
      <documentation>Habilidad para identificar, actualizar y asegurar canales de comunicación y ubicaciones físicas válidas para interactuar con el cliente, especialmente con aquellos de difícil acceso o inalcanzables por medios convencionales.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Customer Domain Management" id="id-02710cab8356431dbe9d8594541f0dbb"/>
    <element xsi:type="archimate:Capability" name="Verificación de Identidad y Enriquecimiento de Información" id="id-39b600bf685444fbbc151a67193b3adf">
      <documentation>Capacidad de contrastar, validar y complementar los datos internos del cliente con fuentes de información externas, buros de crédito y entidades de Gobierno para asegurar la veracidad de la data y mitigar riesgos.</documentation>
    </element>
  </folder>
