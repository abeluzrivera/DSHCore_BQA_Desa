{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "HTTPS (Chrome)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/CI_MVC/contactabilidad_inteligente.mcv/contactabilidad_inteligente.mcv/bin/Debug/net10.0/contactabilidad_inteligente.mcv.dll",
            "args": [],
            "cwd": "${workspaceFolder}/CI_MVC/contactabilidad_inteligente.mcv/contactabilidad_inteligente.mcv",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bEscuchando en:\\s+(https://\\S+)",
                "uriFormat": "%s",
                "webRoot": "${workspaceFolder}/contactabilidad_inteligente.mcv/wwwroot"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "https://localhost:7134;http://localhost:5228"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            },
            "browser": "chrome"
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}